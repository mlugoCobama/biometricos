{
    "name": "biometric/lumen-api",
    "description": "Lumen API for ZKTeco Biometric Devices PUSH ADMS Protocol",
    "keywords": ["lumen", "zkteco", "adms", "push-protocol", "biometric", "attendance"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2 || ^8.3",
        "laravel/lumen-framework": "^10.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
